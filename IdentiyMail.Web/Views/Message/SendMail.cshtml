@model ComposeMessageViewModel

@{
    ViewData["Title"] = "Yeni Mesaj";

    var categorySelectorModel = new CategorySelectorViewModel
    {
        InputName = "Form.CategoryId",
        SelectedCategoryId = Model.Form.CategoryId,
        Categories = Model.Categories,
        Label = "Kategori"
    };
}

<section class="mail-compose-page">
    <div class="mail-compose-panel">
        <div class="mail-compose-header">
            <div>
                <h1>
                    @(Model.Form.DraftId.HasValue ? "Taslağı Düzenle" : "Yeni Mesaj")
                </h1>
                <span>
                    @(Model.Form.DraftId.HasValue ? "Taslak mesajınızı düzenleyin" : "Yeni mesaj oluşturun")
                </span>
            </div>

            <a asp-controller="Message"
               asp-action="Index"
               class="mail-compose-close"
               title="Kapat">

                <span class="material-symbols-outlined">
                    close
                </span>
            </a>
        </div>

        <form asp-controller="Message"
              asp-action="SendMail"
              method="post"
              class="mail-compose-form">

            <input asp-for="Form.DraftId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="mail-compose-validation"></div>

            <div class="mail-compose-field">
                <label asp-for="Form.ReceiverMail">Kime</label>
                <input asp-for="Form.ReceiverMail" type="email" placeholder="Alıcının email adresi" />
                <span asp-validation-for="Form.ReceiverMail" class="mail-compose-field-error"></span>
            </div>

            <div class="mail-compose-field">
                <label asp-for="Form.Subject">Konu</label>
                <input asp-for="Form.Subject" placeholder="Mesaj konusu" />
                <span asp-validation-for="Form.Subject" class="mail-compose-field-error"></span>
            </div>

            @* #region Kategori *@
            <partial name="_CategorySelector"
                     model="categorySelectorModel" />
            @* #endregion *@

            <div class="mail-compose-body">
                <textarea asp-for="Form.Body"
                          placeholder="Mesajınızı yazın..."
                          autofocus>
                </textarea>

                <span asp-validation-for="Form.Body" class="mail-compose-field-error"></span>
            </div>

            <div class="mail-compose-footer">
                <button type="submit" class="mail-compose-send-button">
                    <span>Gönder</span>

                    <span class="material-symbols-outlined">send</span>
                </button>

                <button type="submit"
                        asp-controller="Message"
                        asp-action="SaveDraft"
                        formnovalidate
                        class="mail-compose-draft-button">

                        <span class="material-symbols-outlined">
                            draft
                        </span>

                        <span>
                            @(Model.Form.DraftId.HasValue ? "Taslağı Güncelle" : "Taslak Olarak Kaydet")
                        </span>
                </button>

                <a asp-controller="Message"
                    asp-action="Index"
                    class="mail-compose-cancel-button">
                    İptal
                </a>
            </div>
        </form>
    </div>
</section>

