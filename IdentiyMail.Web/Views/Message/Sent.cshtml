@model List<UserMessage>

@{
    ViewData["Title"] = "Gönderilenler";
}

<h3>Gönderilen Mesajlar</h3>

@if (TempData["MessageSuccess"] is not null)
{
    <div class="alert alert-success">
        @TempData["MessageSuccess"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-light border">
        Henüz gönderilmiş bir mesajınız bulunmuyor.
    </div>
}
else
{
    <table class="table table-bordered table-hover">

        <thead>
            <tr>
                <th>Alıcı Ad Soyad</th>
                <th>Email</th>
                <th>Konu</th>
                <th>Tarih</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Receiver.FirstName
                        @item.Receiver.LastName
                    </td>

                    <td>
                        @item.Receiver.Email
                    </td>

                    <td>
                        @item.Subject
                    </td>

                    <td>
                        @item.SendDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td class="text-end">

                        <a asp-controller="Message"
                           asp-action="SentMailDetail"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-info">

                            Maili Görüntüle

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<a asp-controller="Message"
   asp-action="SendMail"
   class="btn btn-dark">
    Yeni Mail Gönder
</a>