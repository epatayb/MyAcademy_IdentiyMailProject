@using System.Globalization
@model List<SentMessageViewModel>

@{
    ViewData["Title"] = "Gönderilenler";
    var trCulture = new CultureInfo("tr-TR");
}

<section class="mail-inbox-page">
    <div class="mail-inbox-panel">
        <div class="mail-inbox-header">
            <div class="mail-inbox-heading">
                <div class="mail-inbox-title-row">
                    <h1>Gönderilenler</h1>

                    @if (Model.Count > 0)
                    {
                        <span class="mail-unread-summary">
                            @Model.Count mesaj
                        </span>
                    }
                </div>

                <span class="mail-inbox-total">
                    Gönderdiğiniz mesajlar
                </span>
            </div>
        </div>

        @if (TempData["MessageSuccess"] is not null)
        {
            <div class="mail-success-alert">
                @TempData["MessageSuccess"]
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="mail-empty-state">
                <span class="material-symbols-outlined">
                    send
                </span>

                <h2>Gönderilmiş mesajınız yok</h2>

                <p>Gönderdiğiniz mesajlar burada görüntülenecek.</p>
            </div>
        }
        else
        {
            <div class="mail-message-list">
                @foreach (var item in Model)
                {
                    <div class="mail-message-row-wrapper">
                        <a asp-controller="Message"
                           asp-action="SentMailDetail"
                           asp-route-id="@item.Id"
                           class="mail-sent-row">

                            @if (!string.IsNullOrWhiteSpace(item.ReceiverProfileImageUrl))
                            {
                                <img src="@item.ReceiverProfileImageUrl"
                                     alt="@item.ReceiverFullName"
                                     class="mail-message-avatar" />
                            }
                            else
                            {
                                <span class="mail-message-avatar mail-message-initials">
                                    @item.ReceiverInitials
                                </span>
                            }

                            <div class="mail-message-sender">
                                <span class="mail-message-sender-name">
                                    @item.ReceiverFullName
                                </span>

                                <span class="mail-message-sender-email">
                                    @item.ReceiverEmail
                                </span>
                            </div>

                            <div class="mail-message-content">
                                <div class="mail-message-subject-line">
                                    <span class="mail-message-subject">
                                        @item.Subject
                                    </span>

                                    @if (item.Category is not null)
                                    {
                                        <partial name="_CategoryBadge" model="item.Category" />
                                    }
                                </div>

                                <span class="mail-message-preview">
                                    - @item.Preview
                                </span>
                            </div>

                            <div class="mail-sent-meta">
                                <span class="mail-read-status @(item.IsRead ? "is-read" : "")">
                                    <span class="material-symbols-outlined">
                                        @(item.IsRead ? "done_all" : "done")
                                    </span>

                                    @(item.IsRead ? "Okundu" : "Okunmadı")
                                </span>

                                <time class="mail-message-date" datetime="@item.SendDate.ToString("O")">
                                    @if (item.SendDate.Date == DateTime.Today)
                                    {
                                        @item.SendDate.ToString("HH:mm")
                                    }
                                    else if (item.SendDate.Date == DateTime.Today.AddDays(-1))
                                    {
                                        <text>Dün</text>
                                    }
                                    else if (item.SendDate.Year == DateTime.Today.Year)
                                    {
                                        @item.SendDate.ToString("dd MMM", trCulture)
                                    }
                                    else
                                    {
                                        @item.SendDate.ToString("dd MMM yyyy",trCulture)
                                    }
                                </time>
                            </div>
                        </a>

                        <form asp-controller="Message"
                              asp-action="MoveToTrash"
                              asp-route-id="@item.Id"
                              asp-route-side="sender"
                              asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                              method="post"
                              class="mail-message-trash-form">

                            <button type="submit"
                                    class="mail-message-trash-button"
                                    title="Çöp kutusuna taşı">

                                <span class="material-symbols-outlined">
                                    delete
                                </span>

                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</section>