@model UserMessage

@{
    ViewData["Title"] = "Gönderilen Mesaj";
}

<h1>Gönderilen Mail İçeriği</h1>

<table class="table table-striped">

    <tr>
        <th>Alıcı Ad Soyad:</th>

        <td>
            @Model.Receiver.FirstName
            @Model.Receiver.LastName
        </td>
    </tr>

    <tr>
        <th>Alıcı Email:</th>
        <td>@Model.Receiver.Email</td>
    </tr>

    <tr>
        <th>Konu:</th>
        <td>@Model.Subject</td>
    </tr>

    <tr>
        <th>Tarih:</th>
        <td>@Model.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
    </tr>

    <tr>
        <th>Mail İçeriği:</th>
        <td>@Model.Body</td>
    </tr>

</table>

<a asp-controller="Message"
   asp-action="Sent"
   class="btn btn-outline-dark">
    Gönderilenlere Geri Dön
</a>