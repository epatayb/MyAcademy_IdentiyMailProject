@using System.Globalization
@model MessageDetailViewModel

@{
    ViewData["Title"] = "Mesaj Detay";
    var trCulture = new CultureInfo("tr-TR");

    var categoryQuickSelector = new CategoryQuickSelectorViewModel
    {
        MessageId = Model.Id,
        SelectedCategoryId = Model.CategoryId,
        Categories = Model.Categories,
        ReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}"
    };
}

<section class="mail-detail-page">
    <div class="mail-detail-panel">
        <div class="mail-detail-toolbar">
            <a asp-controller="Message"
               asp-action="Index"
               class="mail-detail-back-button"
               title="Gelen kutusuna dön">

               <span class="material-symbols-outlined">
                   arrow_back
               </span>

               <span>Gelen Kutusu</span>
            </a>

            <div class="mail-detail-toolbar-actions">
                <form asp-controller="Message"
                      asp-action="ToggleImportant"
                      asp-route-id="@Model.Id"
                      asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                      method="post">

                      <button type="submit"
                              class="mail-detail-icon-button @(Model.IsImportant ? "is-important" : "")"
                              title="@(Model.IsImportant ? "Önemlilerden kaldır" : "Önemli olarak işaretle")">

                              <span class="material-symbols-outlined">
                                  star
                              </span>
                      </button>
                </form>

                <form asp-controller="Message"
                      asp-action="MoveToTrash"
                      asp-route-id="@Model.Id"
                      asp-route-side="receiver"
                      asp-route-returnUrl="@Url.Action("Index", "Message")"
                      method="post">

                      <button type="submit"
                              class="mail-detail-icon-button is-danger"
                              title="Çöp kutusuna taşı">

                              <span class="material-symbols-outlined">
                                  delete
                              </span>
                      </button>
                </form>
            </div>
        </div>

        <div class="mail-detail-heading mail-detail-heading-with-category">
            <h1>@Model.Subject</h1>

            <partial name="_CategoryQuickSelector" model="categoryQuickSelector" />
        </div>

        <div class="mail-detail-contact">
            @if(!string.IsNullOrWhiteSpace(Model.ContactProfileImageUrl))
            {
                <img src="@Model.ContactProfileImageUrl"
                     alt="@Model.ContactFullName"
                     class="mail-detail-avatar"/>
            }
            else
            {
                <span class="mail-detail-avatar mail-message-initials">
                    @Model.ContactInitials
                </span>
            }

            <div class="mail-detail-contact-info">
                <span class="mail-detail-contact-name">
                    @Model.ContactFullName
                </span>

                <span class="mail-detail-contact-email">
                    @Model.ContactEmail
                </span>
            </div>

            <time class="mail-detail-date" datetime="@Model.SendDate.ToString("O")">
                @Model.SendDate.ToString("dd MMMM yyyy HH:mm", trCulture)
            </time>
        </div>

        <div class="mail-detail-body">
            @Model.Body
        </div>

        <div class="mail-detail-footer">
            <a asp-controller="Message"
               asp-action="Reply"
               asp-route-id="@Model.Id"
               class="mail-detail-reply-button">
               
               <span class="material-symbols-outlined">
                   reply
               </span>

               <span>Yanıtla</span>
            </a>
        </div>
    </div>
</section>
