@using System.Globalization
@model InboxViewModel

@{
    ViewData["Title"] = "Gelen Kutusu";
    var trCulture = new CultureInfo("tr-TR");
}

<section class="mail-inbox-page">
    <div class="mail-inbox-panel">
        @* #region Gelen kutusu başlık ve filtreler *@
        <div class="mail-inbox-header">
            <div class="mail-inbox-heading">
                <div class="mail-inbox-title-row">
                    <h1>Gelen Kutusu</h1>

                    @if (Model.UnreadCount > 0)
                    {
                        <span class="mail-unread-summary">
                            <span class="mail-unread-dot"></span>
                            @Model.UnreadCount okunmamış mesaj
                        </span>
                    }
                </div>

                <span class="mail-inbox-total">
                    Toplam @Model.TotalCount ileti
                </span>
            </div>

            <nav class="mail-inbox-filters" aria-label="Mesaj filtreleri">
                <a asp-controller="Message"
                    asp-action="Index"
                    asp-route-status="all"
                    class="mail-filter-tab @(Model.Status == "all" ? "is-active" : "")">
                    Tümü
                </a>

                <a asp-controller="Message"
                    asp-action="Index"
                   asp-route-status="unread"
                   class="mail-filter-tab @(Model.Status == "unread" ? "is-active" : "")">

                   <span>Okunmamış</span>

                   @if (Model.UnreadCount > 0)
                   {
                       <span class="mail-filter-count">
                           @Model.UnreadCount
                       </span>
                   }
               </a>

                <a asp-controller="Message"
                   asp-action="Index"
                   asp-route-status="read"
                   class="mail-filter-tab @(Model.Status == "read" ? "is-active" : "")">
                    Okunmuş
                </a>
            </nav>
        </div>
        @* #endregion *@

        @* #region Gelen kutusu mesaj listesi *@
        @if(Model.Messages.Count == 0)
        {
            <div class="mail-empty-state">

                <span class="material-symbols-outlined">
                    inbox
                </span>

                @if (Model.Status == "unread")
                {
                    <h2>Okunmamış mesajınız yok</h2>

                    <p>
                        Gelen kutunuzdaki tüm mesajları okumuşsunuz.
                    </p>
                }
                else if (Model.Status == "read")
                {
                    <h2>Okunmuş mesajınız yok</h2>

                    <p>
                        Okuduğunuz mesajlar burada görüntülenecek.
                    </p>
                }
                else
                {
                    <h2>Gelen kutunuz boş</h2>

                    <p>
                        Yeni mesajlar geldiğinde burada görüntülenecek.
                    </p>
                }
            </div>
        }
        else
        {
            <div class="mail-meesage-list">
                @foreach(var item in Model.Messages)
                {
                    <a asp-controller="Message"
                        asp-action="MailDetail"
                        asp-route-id="@item.Id"
                        class="mail-message-row @(!item.IsRead ? "is-unread" : "")">
                        
                        <span class="material-symbols-outlined mail-message-star @(item.IsImportant ? "is-important" : "")"
                            title="@(item.IsImportant ? "Önemli mesaj" : "Normal mesaj")">
                            star
                        </span>

                        @if (!string.IsNullOrWhiteSpace(item.SenderProfileImageUrl))
                        {
                            <img src="@item.SenderProfileImageUrl"
                                 alt="@item.SenderFullName"
                                 class="mail-message-avatar" />
                        }
                        else
                        {
                            <span class="mail-message-avatar mail-message-initials">
                                @item.SenderInitials
                            </span>
                        }

                        <div class="mail-message-sender">

                            <span class="mail-message-sender-name">
                                @item.SenderFullName
                            </span>

                            <span class="mail-message-sender-email">
                                @item.SenderEmail
                            </span>

                        </div>

                        <div class="mail-message-content">

                            <span class="mail-message-subject">
                                @item.Subject
                            </span>

                            <span class="mail-message-preview">
                                — @item.Preview
                            </span>

                        </div>

                        <time class="mail-message-date" datetime="@item.SendDate.ToString("O")">

                            @if (item.SendDate.Date == DateTime.Today)
                            {
                                @item.SendDate.ToString("HH:mm")
                            }
                            else if (item.SendDate.Date == DateTime.Today.AddDays(-1))
                            {
                                <text>Dün</text>
                            }
                            else if (item.SendDate.Year == DateTime.Today.Year)
                            {
                                @item.SendDate.ToString("dd MMM", trCulture)
                            }
                            else
                            {
                                @item.SendDate.ToString("dd MMM yyyy", trCulture)
                            }
                        </time>
                    </a>
                }
            </div>
        }
    </div>
</section>