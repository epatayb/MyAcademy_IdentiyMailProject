@model List<InboxMessageViewModel>

@{
    ViewData["Title"] = "Önemli";
}

<section class="mail-inbox-page">
    <div class="mail-inbox-panel">
        @* #region Önemli mesajlar başlığı *@
        <div class="mail-inbox-header">
            <div class="mail-inbox-heading">
                <div class="mail-inbox-title-row">
                    <h1>Önemli</h1>

                    <span class="mail-unread-summary">
                        @Model.Count mesaj
                    </span>
                </div>

                <span class="mail-inbox-total">
                    Önemli olarak işaretlediğiniz mesajlar
                </span>                
            </div>
        </div>
        @* #endregion *@

        
        @* #region Önemli mesaj listesi *@
        @if (Model.Count == 0)
        {
            <div class="mail-empty-state">
                <span class="material-symbols-outlined">
                    star
                </span>

                <h2>Önemli mesajınız yok</h2>

                <p>
                    Yıldız eklediğiniz mesajlar burada görüntülenecek.
                </p>
            </div>
        }
        else
        {
            <div class="mail-message-list">
                @foreach (var item in Model)
                {
                    <partial name="_MessageRow" model="item" />
                }
            </div>
        }
        @* #endregion *@
    </div>
</section>