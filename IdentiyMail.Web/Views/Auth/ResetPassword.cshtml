@model ResetPasswordDto

@{
    ViewData["Title"] = "Yeni Şifre";
}

<div class="row justify-content-center">
    <div class="col-lg-5">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h3>Yeni Şifre Belirle</h3>

                <p class="text-muted">
                    Hesabınız için yeni bir şifre oluşturun.
                </p>


                <form method="post">

                    <input asp-for="Email"
                           type="hidden" />

                    <input asp-for="Token"
                           type="hidden" />


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="mb-3">

                        <label asp-for="NewPassword"
                               class="form-label">
                            Yeni Şifre
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-4">

                        <label asp-for="ConfirmNewPassword"
                               class="form-label">
                            Yeni Şifre Tekrar
                        </label>

                        <input asp-for="ConfirmNewPassword"
                               class="form-control" />

                        <span asp-validation-for="ConfirmNewPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <button type="submit"
                            class="btn btn-dark">
                        Şifremi Yenile
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}