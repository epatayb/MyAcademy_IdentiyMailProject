@model LoginDto
@{
    ViewData["Title"] = "Giriş Yap";
}

<h1>Giriş Yap</h1>

@if (TempData["AuthSuccess"] is not null)
{
    <div class="alert alert-success">
        @TempData["AuthSuccess"]
    </div>
}

<form method="post">
    <label>Email</label>
    <input type="email" asp-for="Email" class="form-control" required/>
    <br />

    <label>Şifre</label>
    <input type="password" asp-for="Password" class="form-control" required />
    <br />

    <a asp-controller="Auth"
       asp-action="ForgotPassword"
       class="text-decoration-none">
        Şifremi Unuttum
    </a>

    <span class="text-danger">@Html.ValidationSummary()</span>

    <button class="btn btn-outline-primary">Giriş Yap</button>
</form>