@model AccountDto

@{
    ViewData["Title"] = "Hesabım";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">
                <h3 class="mb-1">Hesabım</h3>

                <p class="text-muted mb-4">
                    Hesap bilgilerinizi görüntüleyebilir ve güncelleyebilirsiniz.
                </p>

                @if (TempData["AccountSuccess"] is not null)
                {
                    <div class="alert alert-success">
                        @TempData["AccountSuccess"]
                    </div>
                }

                <div class="text-center mb-4">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl"
                             alt="Profil Fotoğrafı"
                             class="rounded-circle"
                             style="width: 110px; height: 110px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                             style="width: 110px; height: 110px; font-size: 36px">
                            @Model.FirstName.FirstOrDefault()
                        </div>
                    }
                </div>

                <form asp-controller="Account" asp-action="Index" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="ProfileImage" class="form-control">Profil Fotoğrafı</label>
                        <input asp-for="ProfileImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                        <span asp-validation-for="ProfileImage" class="text-danger"></span>
                        <div class="form-text">Sadece .jpg, .jpeg, .png ve .webp uzantılı dosyalar yüklenebilir. Maksimum boyut 2 MB.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">
                                Ad
                            </label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">
                                Soyad
                            </label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Kullanıcı Adı
                        </label>
                        <input class="form-control" value="@Model.UserName" disabled />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            Email
                        </label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-dark">
                            Değişiklikleri Kaydet
                        </button>

                        <a asp-controller="Account"
                           asp-action="ChangePassword"
                           class="btn btn-outline-secondary">
                            Şifreyi Değiştir
                        </a>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}